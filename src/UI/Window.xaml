<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabula" Width="980" Height="640" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Rail -->
    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,22,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10,0,0,22">
          <TextBlock Text="Tabula" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Clean slate, on demand." Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavSetup" Style="{DynamicResource NavItem}" GroupName="Nav" Content="Setup" AutomationProperties.Name="Setup" IsChecked="True"/>
          <RadioButton x:Name="NavApps" Style="{DynamicResource NavItem}" GroupName="Nav" Content="Apps" AutomationProperties.Name="Apps"/>
          <RadioButton x:Name="NavTweaks" Style="{DynamicResource NavItem}" GroupName="Nav" Content="Tweaks" AutomationProperties.Name="Tweaks"/>
          <RadioButton x:Name="NavTools" Style="{DynamicResource NavItem}" GroupName="Nav" Content="Tools" AutomationProperties.Name="Tools"/>
          <RadioButton x:Name="NavAbout" Style="{DynamicResource NavItem}" GroupName="Nav" Content="About" AutomationProperties.Name="About"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="MachineText" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="10,0,0,0" Text="Detecting your machine."/>
      </Grid>
    </Border>

    <!-- Content -->
    <ContentControl Grid.Row="0" Grid.Column="1" x:Name="PageHost" Margin="32,28,32,12" IsTabStop="False"/>

    <!-- Status bar -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}" Padding="20,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource Caption}" VerticalAlignment="Center" Text="Ready."/>
        <ProgressBar x:Name="StatusProgress" Grid.Column="1" Width="180" VerticalAlignment="Center" Visibility="Hidden" Value="0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
