{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tabula presets.json",
  "description": "For editors and other tools. References to app and tweak IDs are checked by src/Core/Config.ps1.",
  "type": "object",
  "required": ["schemaVersion", "presets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "apps", "tweaks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "apps": { "oneOf": [{ "const": "defaultSelected" }, { "type": "array", "items": { "type": "string" } }] },
          "tweaks": { "oneOf": [{ "const": "defaultOn" }, { "type": "array", "items": { "type": "string" } }] },
          "overrides": {
            "type": "object",
            "propertyNames": { "enum": ["laptop", "desktop", "win10", "win11", "hdd", "ssd"] },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "addTweaks": { "type": "array", "items": { "type": "string" } },
                "excludeTweaks": { "type": "array", "items": { "type": "string" } },
                "addApps": { "type": "array", "items": { "type": "string" } },
                "excludeApps": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
