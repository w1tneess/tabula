<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="About" Style="{DynamicResource Title}"/>
    <TextBlock Style="{DynamicResource Dim}" Margin="0,6,0,22" Text="Does one job. Tries to do it quietly."/>

    <Border Style="{DynamicResource Card}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Version" Style="{DynamicResource Caption}" Margin="0,3,0,6"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersion" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Build" Style="{DynamicResource Caption}" Margin="0,3,0,6"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutBuild" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="2" Text="Log folder" Style="{DynamicResource Caption}" Margin="0,3,0,6"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutLogs" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="3" Text="Licence" Style="{DynamicResource Caption}" Margin="0,3,0,0"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT"/>
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
      <Button x:Name="BtnOpenLogs" Content="Open logs" AutomationProperties.Name="Open logs"/>
      <Button x:Name="BtnUndoLast" Content="Undo last run" Margin="10,0,0,0" IsEnabled="False" ToolTip="Undo from the window arrives in M4. Use -Mode Undo for now." AutomationProperties.Name="Undo last run"/>
    </StackPanel>
  </StackPanel>
</ScrollViewer>
